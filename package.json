{
  "name": "@eleata/peppol",
  "version": "0.1.0",
  "description": "Node SDK for the eleata Peppol API — validate EU invoices in 5 lines.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": ["peppol", "xrechnung", "factur-x", "ubl", "einvoice", "validation", "eu", "invoice"],
  "author": "eleata",
  "license": "MIT",
  "homepage": "https://peppol.eleata.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hernaninverso/peppol-node.git"
  },
  "bugs": {
    "url": "https://github.com/hernaninverso/peppol-node/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
